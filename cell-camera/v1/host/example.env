# /etc/rosie-cell-camera/<name>.env: one camera. Lines are KEY=value, no quotes.
# Find the device and its modes on the host:
#   ls /dev/v4l/by-id/                       (use the -video-index0 name; it survives replugging)
#   v4l2-ctl -d <device> --list-formats-ext  (or: gst-device-monitor-1.0 Video/Source)

# Required.
CELL_CAMERA_DEVICE=/dev/v4l/by-id/usb-Arducam_Arducam_B0495__USB3_2.3MP__Arducam_202500915_0001-video-index0
CELL_CAMERA_CAPTURE=1920x1200@30

# A RealSense instead (README "RealSense"): no CELL_CAMERA_DEVICE, and install.sh --realsense-sdk <dir>.
#CELL_CAMERA_SOURCE=realsense
#CELL_CAMERA_REALSENSE_SERIAL=215122251234  # needed only with more than one RealSense connected
#CELL_CAMERA_REALSENSE_DEPTH=640x480@15      # raw depth at <prefix>/depth.z16; absent: colour only

# Optional, with their defaults.
#CELL_CAMERA_PIXEL_FORMAT=YUY2
#CELL_CAMERA_CROP=1080x810+420+75      # keep WIDTHxHEIGHT at LEFT,TOP of the capture (a vignetting lens)
#CELL_CAMERA_OUTPUT=1920x1200          # smaller scales down: less bandwidth, softer picture
#CELL_CAMERA_JPEG_QUALITY=88
#CELL_CAMERA_ENCODER=auto              # auto | nvidia (Jetson) | software
#CELL_CAMERA_LISTEN=127.0.0.1:8088     # loopback only; the OLP server on this host relays it
#CELL_CAMERA_PATH_PREFIX=/camera
#CELL_CAMERA_NAME=Arducam B0495
#CELL_CAMERA_TITLE=Cell 3 / Bench
#CELL_CAMERA_IDLE_STOP_SECONDS=8
#CELL_CAMERA_MAX_FRAME_AGE_SECONDS=0.5

# Low-data video (cell-camera/v1/video.py and video/): set the address to turn it on.
#CELL_CAMERA_VIDEO_ADDRESS=100.64.0.11  # the host's Tailscale address; WebRTC listens only there
#CELL_CAMERA_VIDEO_PORT=40400           # the one UDP port all viewers share
#CELL_CAMERA_VIDEO_LISTEN=127.0.0.1:8090  # the sender's WHEP port, loopback; the OLP relays it
#CELL_CAMERA_VIDEO_WIDTH=960            # the height keeps the crop's shape
#CELL_CAMERA_VIDEO_FPS=15
#CELL_CAMERA_VIDEO_KBPS=800
